# Ozon Seller API (опционально — магазины удобнее добавлять через веб-UI /shops)
OZON_CLIENT_ID=
OZON_API_KEY=

# Ozon Performance API (реклама)
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Токен авторизации MCP-эндпоинтов (/sse и /messages).
# ОБЯЗАТЕЛЬНО задать при доступе из внешней сети!
# Сгенерировать: openssl rand -hex 32
# Клиент передаёт: Authorization: Bearer <токен> или ?token=<токен>
MCP_AUTH_TOKEN=

# Интервал фоновой диагностики Ozon API в минутах (0 = выключить)
HEALTH_CHECK_INTERVAL_MIN=30

# Директория данных (shops.json, stats.db, .encryption_key)
# DATA_DIR=/data

# Порт сервера (по умолчанию 8000)
# PORT=8000
